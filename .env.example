# Copy this file to .env and fill in real values. Never commit .env.

APP_ENV=development
SECRET_KEY=generate-with-python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=postgresql://user:password@localhost/scholarinsights
FLASK_DEBUG=false

# Set to true once served over HTTPS / behind a proxy
SESSION_COOKIE_SECURE=false
BEHIND_PROXY=false

# Email (leave MAIL_SERVER empty to turn sending off in development)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=InsightScholar <no-reply@insightscholar.com>

# Virus scanning for uploads (ClamAV)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
